{
  "name": "slave-management",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm run tsoa:gen && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
